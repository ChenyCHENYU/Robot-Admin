# 本地环境
VITE_MODE_NAME = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = hash

# 是否开启 VitePWA
VITE_PWA = false

# 开发环境接口地址
VITE_BASE_URL = https://apifoxmock.com/m1/4902805-4559325-default

# 开发环境跨域代理，支持配置多个，下面是APIFOX地址
VITE_PROXY = [["/api","https://apifoxmock.com/m1/4902805-4559325-default"]]

